# Public origin used in verification, reset, and invitation links.
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
# Optional Vite development proxy override.
API_DEV_TARGET=http://127.0.0.1:8787

# Use a standard PostgreSQL URL from any managed or self-hosted provider.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/startrips
DATABASE_SSL=false
# Keep certificate verification enabled in production. For a private CA,
# provide its PEM content as base64 instead of disabling verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_BASE64=

# Generate at least 32 random bytes for production.
BETTER_AUTH_SECRET=

# Google sign-in. Leave both empty to keep the provider off; setting exactly one
# refuses startup. deploy/README.md lists the redirect URIs to authorize.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any SMTP server is supported. Production startup requires both values.
SMTP_URL=
MAIL_FROM=Startrips <no-reply@example.com>

# Keep disabled until a private bucket and CORS policy are ready.
# The same settings support AWS S3, Tencent COS, Alibaba OSS, and MinIO.
STORAGE_DRIVER=disabled
# Stable location identity persisted with media rows; do not reuse it for a new bucket.
S3_BACKEND_ID=
S3_ENDPOINT=
S3_KEY_PREFIX=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_PART_EXPIRES_IN_SECONDS=900
# Signed private-media read URL lifetime in seconds (60-3600).
MEDIA_READ_URL_EXPIRES_IN_SECONDS=900
# Signed media read URL lifetime for a share-link guest, in seconds (15-600).
# Deliberately far shorter than the owner value: a presigned storage URL cannot
# be revoked, so this is the residual window after a share is withdrawn. The
# issued value is additionally capped by the grant's remaining lifetime.
SHARE_MEDIA_READ_URL_EXPIRES_IN_SECONDS=90
# Ceilings for a derived Route Point Media preview. Both are enforced against
# the object a producer actually wrote: completion measures its byte size and
# reads it back for its encoded pixel size, and a still over either ceiling is
# never marked ready. The write itself is presigned for its own short lifetime.
MEDIA_PREVIEW_MAX_EDGE_PIXELS=640
MEDIA_PREVIEW_MAX_BYTES=524288
MEDIA_PREVIEW_UPLOAD_EXPIRES_IN_SECONDS=120

# Abuse budgets for the guest share prefix, and only for it: /api/shared/*.
# Startrips has no application-wide API rate limiter, deliberately. These are
# per-window ceilings for the one public, unauthenticated surface it exposes.
# The two request budgets are counted per share grant, so one forwarded link
# has one budget no matter how many recipients open it; the unknown-token
# budget is counted per client address, because a request whose token resolves
# to nothing has no grant to charge.
SHARE_RATE_LIMIT_WINDOW_SECONDS=60
SHARE_DATA_RATE_LIMIT=60
SHARE_MEDIA_RATE_LIMIT=240
SHARE_UNKNOWN_TOKEN_RATE_LIMIT=30

# Location search remains disabled until a provider adapter is installed.
# Manual coordinates and globe picking continue to work in this state.
LOCATION_SEARCH_DRIVER=disabled

# Cover-reveal worker (#368). Unset by default: with no credential the worker
# routes refuse everything and the rest of the API is unaffected. Set a random
# secret of at least 32 characters to enable an external local worker, and
# rotate it by changing this value and restarting. The credential grants only
# the /api/cover-reveal-worker/* routes: no Journey read, no media
# enumeration, no share, no database and no object-store credential.
# COVER_REVEAL_WORKER_TOKEN=
# How long one claim owns a job (60-3600). An expired lease is reclaimable.
COVER_REVEAL_LEASE_SECONDS=600
# The two capability windows, each bounded by the lease above.
COVER_REVEAL_SOURCE_READ_EXPIRES_IN_SECONDS=300
COVER_REVEAL_UPLOAD_EXPIRES_IN_SECONDS=600
# Ceilings for the generated derivative, enforced against the object that
# actually landed: a job over either ceiling never becomes ready.
COVER_REVEAL_MAX_BYTES=4194304
COVER_REVEAL_MAX_EDGE_PIXELS=2048
# How many claims one job may spend before it stops being claimable.
COVER_REVEAL_MAX_ATTEMPTS=3

# Sign in with Apple (#350). Unset by default: with no credential the provider
# is absent, /api/auth/sign-in/social reports an unknown provider and
# /api/account-identities advertises no bindable provider. Naming some but not
# all four values fails startup rather than half-enabling a sign-in.
# APPLE_SERVICE_ID is the approved Services identifier, APPLE_TEAM_ID the
# Developer Team, APPLE_KEY_ID the Sign in with Apple key, and
# APPLE_PRIVATE_KEY the PKCS#8 PEM text of the downloaded .p8 file (write its
# newlines as a literal backslash-n). The server signs its own client secret
# from these; nothing here reaches the browser. See docs/architecture/apple-sign-in.md.
# APPLE_SERVICE_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# Optional: a native bundle identifier accepted as an additional id-token
# audience. The web flow does not need it.
# APPLE_APP_BUNDLE_IDENTIFIER=

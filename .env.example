# Public origin used in verification, reset, and invitation links.
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
# Optional Vite development proxy override.
API_DEV_TARGET=http://127.0.0.1:8787

# Use a standard PostgreSQL URL from any managed or self-hosted provider.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/startrips
DATABASE_SSL=false
# Keep certificate verification enabled in production. For a private CA,
# provide its PEM content as base64 instead of disabling verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_BASE64=

# Generate at least 32 random bytes for production.
BETTER_AUTH_SECRET=

# Any SMTP server is supported. Production startup requires both values.
SMTP_URL=
MAIL_FROM=Startrips <no-reply@example.com>

# Keep disabled until a private bucket and CORS policy are ready.
# The same settings support AWS S3, Tencent COS, Alibaba OSS, and MinIO.
STORAGE_DRIVER=disabled
# Stable location identity persisted with media rows; do not reuse it for a new bucket.
S3_BACKEND_ID=
S3_ENDPOINT=
S3_KEY_PREFIX=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_PART_EXPIRES_IN_SECONDS=900
# Signed private-media read URL lifetime in seconds (60-3600).
MEDIA_READ_URL_EXPIRES_IN_SECONDS=900
# Signed media read URL lifetime for a share-link guest, in seconds (15-600).
# Deliberately far shorter than the owner value: a presigned storage URL cannot
# be revoked, so this is the residual window after a share is withdrawn. The
# issued value is additionally capped by the grant's remaining lifetime.
SHARE_MEDIA_READ_URL_EXPIRES_IN_SECONDS=90

# Abuse budgets for the guest share prefix, and only for it: /api/shared/*.
# Startrips has no application-wide API rate limiter, deliberately. These are
# per-window ceilings for the one public, unauthenticated surface it exposes.
# The two request budgets are counted per share grant, so one forwarded link
# has one budget no matter how many recipients open it; the unknown-token
# budget is counted per client address, because a request whose token resolves
# to nothing has no grant to charge.
SHARE_RATE_LIMIT_WINDOW_SECONDS=60
SHARE_DATA_RATE_LIMIT=60
SHARE_MEDIA_RATE_LIMIT=240
SHARE_UNKNOWN_TOKEN_RATE_LIMIT=30

# Location search remains disabled until a provider adapter is installed.
# Manual coordinates and globe picking continue to work in this state.
LOCATION_SEARCH_DRIVER=disabled

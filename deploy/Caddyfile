{
	default_sni {$APP_HOST}
}

{$APP_HOST} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:8787
	}

	handle /assets/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	@atlasStatic path /earth/* /fonts/*
	handle @atlasStatic {
		root * /srv
		file_server
		# These files use stable names (for example /earth/cities.json and
		# /fonts/Doto-ROND-wght.ttf), so they are cacheable but not immutable.
		# Revalidate after a short freshness window so a deployment can update
		# earth/font data without leaving clients pinned to an old copy for a year.
		header Cache-Control "public, max-age=3600, must-revalidate"
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The access log records the request URI (path plus query) and the request
	# headers, and both are credential-bearing: a password reset link carries its
	# token as a path segment (/api/auth/reset-password/<token>) while email
	# verification and the SPA reset callback carry it as ?token=. Under the
	# Referrer-Policy above, a same-origin request made from /reset-password?token=
	# sends that full URL as Referer, so the token reaches the log through the
	# header too. Caddy already redacts Cookie and Authorization by default; the
	# same pattern is applied to both remaining fields. One regexp per field is
	# deliberate - Caddy keys log filters by field name, so a second filter on the
	# same field silently replaces the first instead of adding to it.
	log {
		format filter {
			fields {
				request>uri regexp "((?:reset-password|/share|/api/shared)/|[?&](?:token|callbackURL)=)[^/?&#]*" "${1}REDACTED"
				request>headers>Referer regexp "((?:reset-password|/share|/api/shared)/|[?&](?:token|callbackURL)=)[^/?&#]*" "${1}REDACTED"
			}
		}
	}
}

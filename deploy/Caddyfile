{
	default_sni {$APP_HOST}
}

{$APP_HOST} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:8787
	}

	handle /assets/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	@atlasStatic path /earth/* /fonts/*
	handle @atlasStatic {
		root * /srv
		file_server
		# These files use stable names (for example /earth/cities.json and
		# /fonts/Doto-ROND-wght.ttf), so they are cacheable but not immutable.
		# Revalidate after a short freshness window so a deployment can update
		# earth/font data without leaving clients pinned to an old copy for a year.
		header Cache-Control "public, max-age=3600, must-revalidate"
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log
}

APP_HOST=your-domain.example
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-value
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Google sign-in. Leave BOTH empty to keep the provider off; setting exactly
# one refuses startup. See "Google sign-in" in deploy/README.md for the two
# redirect URIs the OAuth client has to authorize.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_DRIVER=disabled
S3_BACKEND_ID=
S3_ENDPOINT=
S3_KEY_PREFIX=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_PART_EXPIRES_IN_SECONDS=900
MEDIA_READ_URL_EXPIRES_IN_SECONDS=900
SHARE_MEDIA_READ_URL_EXPIRES_IN_SECONDS=90
SHARE_RATE_LIMIT_WINDOW_SECONDS=60
SHARE_DATA_RATE_LIMIT=60
SHARE_MEDIA_RATE_LIMIT=240
SHARE_UNKNOWN_TOKEN_RATE_LIMIT=30
LOCATION_SEARCH_DRIVER=photon
LOCATION_SEARCH_BASE_URL=https://photon.komoot.io
LOCATION_SEARCH_USER_AGENT=Startrips/1.0(+https://your-domain.example)
LOCATION_SEARCH_FALLBACK_BASE_URL=
ITINERARY_SOURCE_FETCH_DRIVER=disabled
ITINERARY_SOURCE_RENDER_URL=
ITINERARY_SOURCE_FETCH_TIMEOUT_MS=60000
ITINERARY_SOURCE_MAX_BYTES=4194304
ITINERARY_RECOGNITION_DRIVER=disabled
ITINERARY_RECOGNITION_BASE_URL=
ITINERARY_RECOGNITION_API_KEY=
ITINERARY_RECOGNITION_MODEL=unversioned
ITINERARY_RECOGNITION_TIMEOUT_MS=180000
ATLAS_MAP_STYLE_URL=
# Spike, not production-ready: a self-hosted Protomaps PMTiles basemap the
# deployment owns. Leave empty to keep the proxied OpenFreeMap style. See
# docs/spikes/pmtiles-basemap.md.
ATLAS_PMTILES_URL=
ATLAS_PMTILES_GLYPHS_URL=

# Sign in with Apple (#350). Leave every value empty to run no Apple provider
# at all. Setting some but not all fails startup on purpose. APPLE_PRIVATE_KEY
# is the PKCS#8 PEM text of the downloaded .p8 key; write its newlines as a
# literal backslash-n.
# Rotation and revocation: docs/architecture/apple-sign-in.md.
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

APP_HOST=your-domain.example
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-value
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Google sign-in. Leave BOTH empty to keep the provider off; setting exactly
# one refuses startup. See "Google sign-in" in deploy/README.md for the two
# redirect URIs the OAuth client has to authorize.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_DRIVER=disabled
S3_BACKEND_ID=
S3_ENDPOINT=
S3_KEY_PREFIX=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_PART_EXPIRES_IN_SECONDS=900
MEDIA_READ_URL_EXPIRES_IN_SECONDS=900
# Same-asset previews: the still's ceilings, the producer's write window, and
# the server-side backfill for originals the browser producer never finished.
MEDIA_PREVIEW_MAX_EDGE_PIXELS=640
MEDIA_PREVIEW_MAX_BYTES=524288
MEDIA_PREVIEW_UPLOAD_EXPIRES_IN_SECONDS=120
MEDIA_PREVIEW_BACKFILL_ENABLED=true
MEDIA_PREVIEW_BACKFILL_INTERVAL_SECONDS=60
MEDIA_PREVIEW_BACKFILL_PASS_LIMIT=200
SHARE_MEDIA_READ_URL_EXPIRES_IN_SECONDS=90
SHARE_RATE_LIMIT_WINDOW_SECONDS=60
SHARE_DATA_RATE_LIMIT=60
SHARE_MEDIA_RATE_LIMIT=240
SHARE_UNKNOWN_TOKEN_RATE_LIMIT=30
LOCATION_SEARCH_DRIVER=photon
LOCATION_SEARCH_BASE_URL=https://photon.komoot.io
LOCATION_SEARCH_USER_AGENT=Startrips/1.0(+https://your-domain.example)
LOCATION_SEARCH_FALLBACK_BASE_URL=
# Each optional OSRM instance must use the matching car, foot or bicycle graph.
# Empty disables that mode; existing routes remain visible.
ROUTING_OSRM_DRIVING_BASE_URL=
ROUTING_OSRM_WALKING_BASE_URL=
ROUTING_OSRM_CYCLING_BASE_URL=
# Optional on-demand corridor graphs (road data from Overpass, ODbL) for modes
# without a static OSRM URL above. To enable, start the routing-builder service
# and set http://routing-builder:8080. Empty disables on-demand graphs; a static
# URL above always takes precedence for its mode.
ROUTING_GRAPH_BUILDER_URL=
# Optional local tag of the same pinned OSRM image, for hosts that cannot pull
# ghcr.io reliably. Empty uses the pinned ghcr.io digest.
ROUTING_BUILDER_OSRM_IMAGE=
# Optional GitHub Actions routing worker (private repo, see deploy/README.md).
# All four or none; when set it serves every mode without a static OSRM URL
# and replaces the routing-builder for those modes. The token is a
# fine-grained PAT for that one repository with Actions read/write. The secret
# (>= 32 chars) must equal the worker repo secret ROUTING_CALLBACK_SECRET.
ROUTING_WORKER_REPO=
ROUTING_WORKER_GITHUB_TOKEN=
ROUTING_WORKER_CALLBACK_URL=
ROUTING_WORKER_CALLBACK_SECRET=
ITINERARY_SOURCE_FETCH_DRIVER=disabled
ITINERARY_SOURCE_RENDER_URL=
ITINERARY_SOURCE_FETCH_TIMEOUT_MS=60000
ITINERARY_SOURCE_MAX_BYTES=4194304
ITINERARY_RECOGNITION_DRIVER=disabled
ITINERARY_RECOGNITION_BASE_URL=
ITINERARY_RECOGNITION_API_KEY=
ITINERARY_RECOGNITION_MODEL=unversioned
ITINERARY_RECOGNITION_TIMEOUT_MS=180000
ATLAS_MAP_STYLE_URL=
# Optional deployment-owned Protomaps PMTiles path. Leave the URL empty to
# keep the proxied OpenFreeMap style. The approved validation extract is
# Guangdong + Hong Kong + Macau under an immutable versioned filename.
# This directory is mounted read-only at /srv/basemap by the web container.
ATLAS_BASEMAP_DIR=./basemap
ATLAS_PMTILES_URL=
ATLAS_PMTILES_GLYPHS_URL=

# Sign in with Apple (#350). Leave every value empty to run no Apple provider
# at all. Setting some but not all fails startup on purpose. APPLE_PRIVATE_KEY
# is the PKCS#8 PEM text of the downloaded .p8 key; write its newlines as a
# literal backslash-n.
# Rotation and revocation: docs/architecture/apple-sign-in.md.
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=
# Set to 'disabled' to pause background road snapping; member road tools stay available.
ROUTING_AUTO_SNAPPING=
